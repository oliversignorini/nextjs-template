{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && node scripts/factory/factory.mjs env:reset",
    "dev": "next dev -p ${PORT:-3000}",
    "dev:slot": "node scripts/factory/factory.mjs dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/factory/factory.mjs test:db",
    "test:e2e": "playwright test",
    "e2e": "node scripts/factory/factory.mjs e2e",
    "e2e:baseline": "node scripts/factory/factory.mjs e2e e2e/skeleton.spec.ts e2e/api.spec.ts",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "env": "node scripts/factory/factory.mjs env",
    "env:up": "node scripts/factory/factory.mjs env:up",
    "env:down": "node scripts/factory/factory.mjs env:down",
    "env:reset": "node scripts/factory/factory.mjs env:reset",
    "health": "node scripts/factory/factory.mjs health",
    "design:check": "npx --yes impeccable@4.1.0 detect --json app components",
    "api:check": "tsx scripts/openapi/generate.ts --check",
    "api:generate": "tsx scripts/openapi/generate.ts",
    "gen:types": "node scripts/factory/factory.mjs gen:types"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.563.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.58.2",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supabase": "^2.67.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
