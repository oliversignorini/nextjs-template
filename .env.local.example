# Do not hand-edit .env.local in a factory worktree -- `pnpm env:up` /
# `pnpm env:reset` generate it per FACTORY_SLOT. This file documents the
# shape for a one-off `supabase start` outside the factory (slot 0 values).

PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
