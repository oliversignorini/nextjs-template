# App Template — Environment Variables
# Copy to .env.local for local development: cp .env.local.example .env.local
# All integrations are optional — the app works without any env vars set.

# App Configuration
NEXT_PUBLIC_APP_NAME="App Template"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Configuration (uncomment when connecting to a real backend)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# ---------------------------------------------------------------------------
# Supabase — Authentication & Database
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Stripe — Payments & Subscriptions
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Anthropic — AI / Chat
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Resend — Transactional Email
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
